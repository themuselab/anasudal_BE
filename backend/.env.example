# PostgreSQL (RDS 또는 로컬 docker-compose)
DATABASE_URL=postgresql://anasudal:anasudal@localhost:5432/anasudal

# Gemini — 키를 두 묶음으로 나눈다
#  · GEMINI_API_KEYS  : 답변·임베딩(사용자가 기다리는 경로). 콤마로 여러 개. 하나가 429 면 다음 키로 넘어간다
#  · GEMINI_SUMMARY_KEY: 질문 요약(백그라운드로 DB 에 쌓음) 전용. 답변 쿼터를 갉아먹지 않게 분리
#  · GEMINI_API_KEY    : 예전 이름(키 하나). 위 두 개가 비면 이걸 쓴다
GEMINI_API_KEYS=
GEMINI_SUMMARY_KEY=
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=models/gemini-embedding-2
GEMINI_GEN_MODEL=models/gemini-3.6-flash
GEMINI_THINKING_LEVEL=low
EMBED_DIM=768

# 검색 파라미터 (측정으로 확정한 값)
TOP_K=3

# Redis (없으면 캐시·칩 회전·질문 제한 비활성)
REDIS_URL=redis://localhost:6379/0
ASK_RATE_LIMIT_PER_HOUR=60
PROMPT_COUNT=3

# 세션
SESSION_TTL_HOURS=24

# CORS (프론트 origin, 콤마 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
